# Required
ASI_ONE_API_KEY=your-asi1-api-key        # https://asi1.ai -> API keys
AGENT_SEED=a-long-random-secret-phrase   # determines the agent address; keep it private

# Optional
CROSSREF_MAILTO=you@example.org          # polite-pool contact for the Crossref API
AGENT_PORT=8001
VERIFIER_PORT=8002
VERIFIER_TIMEOUT=45
CITECHECK_HTTP_TIMEOUT=10

# AgentPay (optional). "off" keeps every audit free.
PAYMENT_MODE=off                         # off | testnet_fet
FREE_REFERENCES=3
PRICE_PER_REFERENCE_FET=0.01
ASI1_TIMEOUT=20

# Network policy (see citecheck/net.py): IPv4 only + fast connect timeouts
NET_POLICY=on
NET_CONNECT_TIMEOUT=4

# Agentic layer: ReAct investigator + verifier-feedback reflection
AGENTIC_MODE=on
AGENT_MAX_STEPS=5

# Status messages share the same ASI:One relay as the report. Keep them off
# for reliable report delivery; enable only while debugging a chat connection.
PROGRESS_UPDATES=off
PROGRESS_HEARTBEAT_SECONDS=0          # optional live spinner interval (0 disables it)
PROGRESS_SEND_TIMEOUT=3               # never queue a progress update behind the report
MAX_CHAT_MESSAGE_CHARS=50000          # keep a normal report in one ASI:One message
REPORT_SHOW_AGENT_TRACE=off            # tool transcripts stay in logs unless explicitly needed
VERIFIER_QUEUE_TIMEOUT=5              # use local verification if the agent is busy
